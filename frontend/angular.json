{
  "version": 1,
  "projects": {
    "lekcje": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist",
            "outputHashing": "all"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
